---
// The footer's big "nyq", drawn as a field of dots. Solid cells get filled dots,
// edges and a scatter of interior cells get rings, so the letters read as halftone.
import { WORDMARK } from "../wordmark";

const rows = WORDMARK.length;
const cols = WORDMARK[0].length;
// A fixed scatter so the build is stable.
let seed = 7;
const rand = () => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff) / 0x7fffffff);
const dots: { x: number; y: number; r: number; ring: boolean }[] = [];
WORDMARK.forEach((line, y) => {
  [...line].forEach((ch, x) => {
    const v = Number(ch);
    if (v === 0) return;
    const roll = rand();
    if (v >= 7) dots.push({ x, y, r: roll < 0.1 ? 0.3 : 0.38, ring: roll < 0.1 });
    else if (v >= 3) dots.push({ x, y, r: 0.3, ring: roll < 0.5 });
    else dots.push({ x, y, r: 0.28, ring: true });
  });
});
---
<svg
  viewBox={`-0.5 -0.5 ${cols} ${rows}`}
  class="block h-auto w-full"
  role="img"
  aria-label="nyq"
>
  <g fill="currentColor">
    {dots.filter((d) => !d.ring).map((d) => <circle cx={d.x} cy={d.y} r={d.r} />)}
  </g>
  <g fill="none" stroke="currentColor" stroke-width="0.11" opacity="0.75">
    {dots.filter((d) => d.ring).map((d) => <circle cx={d.x} cy={d.y} r={d.r} />)}
  </g>
</svg>
