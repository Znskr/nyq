---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { href, REPO } from "../lib";

interface Props {
  current: "home" | "docs" | "privacy" | "terms" | "none";
}
const { current } = Astro.props;
const onHome = current === "home";
const links = [
  { label: "Features", url: onHome ? "#features" : href("#features"), spy: "features" },
  { label: "FAQ", url: onHome ? "#faq" : href("#faq"), spy: "faq" },
  { label: "Docs", url: href("docs"), current: current === "docs" },
  { label: "GitHub", url: REPO },
];
const linkCls =
  "title-4 px-3 py-2 text-muted transition-colors duration-200 ease-base hover:text-fg aria-[current=true]:text-fg aria-[current=page]:text-fg";
---
<!-- On the home page the bar floats over the (always dark) hero; elsewhere it sticks to the top. -->
<header
  class:list={[
    "inset-x-0 top-0 z-50",
    onHome ? "theme-dark absolute" : "sticky border-b border-line bg-bg",
  ]}
>
  <nav aria-label="Main" class="mx-auto flex h-16 max-w-6xl items-center gap-2 px-6 sm:h-20">
    <a
      href={href()}
      class="mr-auto flex items-center gap-3 py-2 text-fg transition-opacity duration-200 ease-base hover:opacity-80"
      aria-label="nyq home"
      aria-current={onHome ? "page" : undefined}
    >
      <Logo size={18} />
      <span class="title-1 font-mono tracking-tight">nyq</span>
    </a>

    <ul class="hidden items-center md:flex">
      {links.map((l) => (
        <li>
          <a
            href={l.url}
            class={linkCls}
            data-spy={onHome && l.spy ? l.spy : undefined}
            aria-current={l.current ? "page" : undefined}
            rel={l.url.startsWith("http") ? "noopener" : undefined}
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <button
      type="button"
      class="grid size-10 place-items-center text-muted transition-colors duration-200 ease-base hover:text-fg"
      aria-label="Switch to light theme"
      title="Switch theme"
      data-theme-toggle
    >
      <span data-theme-icon="light"><Icon name="sun" class="size-5" /></span>
      <span data-theme-icon="dark"><Icon name="moon" class="size-5" /></span>
    </button>

    <a
      href={onHome ? "#install" : href("#install")}
      class="button-sm ml-1 hidden bg-fg px-4 py-2.5 text-bg transition-colors duration-200 ease-base hover:bg-fg-hover sm:inline-flex"
    >
      Install
    </a>

    <button
      type="button"
      class="group relative grid size-10 place-items-center text-fg md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
      data-menu-toggle
    >
      <span class="absolute h-0.5 w-4 bg-current transition-transform duration-500 ease-base -translate-y-1 group-aria-expanded:translate-y-0 group-aria-expanded:rotate-45"></span>
      <span class="absolute h-0.5 w-4 bg-current transition-transform duration-500 ease-base translate-y-1 group-aria-expanded:translate-y-0 group-aria-expanded:-rotate-45"></span>
    </button>
  </nav>
</header>

<div
  id="mobile-menu"
  class:list={[
    "invisible fixed inset-0 z-40 px-6 pt-24 opacity-0 transition-opacity duration-500 ease-base data-[open]:visible data-[open]:opacity-100 md:hidden",
    onHome ? "theme-dark bg-black" : "bg-bg",
  ]}
  data-menu
>
  <ul class="flex flex-col gap-1">
    {[...links, { label: "Install", url: onHome ? "#install" : href("#install") }].map((l, i) => (
      <li
        class="translate-y-6 opacity-0 transition duration-500 ease-base [[data-open]_&]:translate-y-0 [[data-open]_&]:opacity-100"
        style={`transition-delay: ${Math.min(i * 60, 400)}ms`}
      >
        <a
          href={l.url}
          class="heading-4 block border-b border-line py-4 text-fg"
          aria-current={"current" in l && l.current ? "page" : undefined}
          data-menu-link
        >
          {l.label}
        </a>
      </li>
    ))}
  </ul>
</div>
