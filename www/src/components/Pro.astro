---
import Icon from "./Icon.astro";
import { NYQ_PRO } from "../lib";

const facts = [
  {
    icon: "lightning",
    title: "DeepSeek Flash V4.1",
    body: "A fast frontier model at roughly 1000 tokens a second, served as <code>nyq-pro/deepseek-flash</code> through an OpenAI compatible endpoint.",
  },
  {
    icon: "frame-corners",
    title: "1M token context",
    body: "The whole working set fits: long files, diffs and tool output, with a 65,536 token output cap per answer.",
  },
  {
    icon: "timer",
    title: "Plain plan windows",
    body: "600 requests / 4M tokens per rolling five hours and 4,000 requests / 25M tokens per week. No per token bill.",
  },
  {
    icon: "hourglass-medium",
    title: "Honest limits",
    body: "A spent window blocks until it resets; nyq reports the reset time instead of retrying or charging you.",
  },
];
---
<section id="pro" class="band" aria-labelledby="pro-title">
  <div class="rail">
    <div class="reveal flex max-w-2xl flex-col gap-4 px-5 pb-12 pt-20 sm:px-10">
      <p class="caption-3 font-mono text-faint">04 / nyq Pro</p>
      <h2 id="pro-title" class="heading-4 sm:heading-3">One subscription, model included</h2>
      <p class="body-3 max-w-xl text-muted">
        nyq Pro is a $10/month Zalthar subscription that comes with the model it
        needs: DeepSeek Flash V4.1 behind an OpenAI compatible gateway. Sign in
        once and pick a model later — plan usage never shows up as a dollar
        cost.
      </p>
    </div>
    <ul class="grid gap-px border-t border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {facts.map((f) => (
        <li class="flex flex-col gap-3 bg-bg p-6 transition-colors duration-300 ease-base hover:bg-surface sm:p-8">
          <Icon name={f.icon} class="size-6 text-fg" />
          <h3 class="title-2 mt-3 text-fg">{f.title}</h3>
          <p class="body-6 text-muted [&_code]:whitespace-nowrap [&_code]:font-mono [&_code]:text-fg" set:html={f.body} />
        </li>
      ))}
    </ul>
    <div class="grid gap-6 border-t border-line px-5 py-10 sm:px-10 md:grid-cols-[1fr_auto] md:items-center">
      <div class="flex min-w-0 flex-col gap-3">
        <p class="body-6 text-muted">Install nyq, then sign in:</p>
        <code class="block w-fit max-w-full overflow-x-auto whitespace-nowrap border border-line bg-surface px-3 py-2 font-mono text-[13px] text-fg [scrollbar-width:none]">
          <span class="select-none text-faint">$ </span>nyq login zalthar
        </code>
      </div>
      <div class="flex flex-col gap-3 md:items-end">
        <a
          href={NYQ_PRO}
          rel="noopener"
          class="button-sm w-fit bg-fg px-4 py-2.5 text-bg transition-colors duration-200 ease-base hover:bg-fg-hover"
        >
          Get nyq Pro
        </a>
        <p class="caption-4 font-mono text-faint">$10/month · cancel anytime</p>
      </div>
    </div>
  </div>
</section>
