---
// The install command in a box with one tab per platform (macOS, Linux, Windows).
// Without JavaScript the macOS command shows, which also works on Linux.
import { INSTALLS } from "../lib";

interface Props {
  id: string;
}
const { id } = Astro.props;
const first = INSTALLS[0];
---
<div class="flex w-full min-w-0 max-w-[36rem] flex-col" data-install>
  <div role="tablist" aria-label="Platform" class="flex w-fit bg-bg font-mono text-[13px]">
    {INSTALLS.map((p, i) => (
      <button
        type="button"
        role="tab"
        id={`${id}-tab-${i}`}
        aria-selected={i === 0 ? "true" : "false"}
        aria-controls={`${id}-panel`}
        tabindex={i === 0 ? 0 : -1}
        class="px-3 py-1.5 text-muted transition-colors duration-200 ease-base hover:text-fg aria-selected:bg-fg aria-selected:text-bg"
        data-os-tab
        data-cmd={p.cmd}
        data-note={p.note}
      >
        {p.os}
      </button>
    ))}
  </div>
  <div
    id={`${id}-panel`}
    role="tabpanel"
    aria-labelledby={`${id}-tab-0`}
    class="flex min-w-0 items-center gap-3 border border-line bg-surface py-1 pl-4 pr-1 font-mono text-[13px]"
  >
    <span class="select-none text-faint" aria-hidden="true">$</span>
    <code id={id} class="min-w-0 flex-1 overflow-x-auto whitespace-nowrap py-2 text-fg [scrollbar-width:none]" data-cmd-text>{first.cmd}</code>
    <button
      type="button"
      class="shrink-0 px-3 py-2 text-muted transition-colors duration-200 ease-base hover:text-fg data-[state=copied]:text-fg"
      data-copy={first.cmd}
      aria-label="Copy install command"
      aria-describedby={`${id}-status`}
    >
      <span data-copy-label>copy</span>
    </button>
  </div>
  <p id={`${id}-status`} class="caption-5 mt-2 w-fit bg-bg font-mono text-muted" aria-live="polite" data-copy-status>
    {first.note}
  </p>
</div>
