---
import Install from "./Install.astro";
import { href, REPO, VERSION } from "../lib";
---
<section class="relative isolate overflow-hidden" aria-labelledby="hero-title">
  <!-- The night scene stays dark in both themes and fades into the page below. -->
  <div class="theme-dark absolute inset-0 -z-10 bg-[#000000]" aria-hidden="true">
    <img
      src={href("art/hero.png")}
      alt=""
      width="1920"
      height="1000"
      fetchpriority="high"
      class="pixelated absolute inset-0 h-full w-full object-cover object-[62%_100%]"
    />
  </div>

  <div class="theme-dark mx-auto flex min-h-[46rem] max-w-6xl flex-col px-6 pb-48 pt-32 sm:pb-64 sm:min-h-[54rem] sm:pt-40">
    <a
      href={`${REPO}/releases/tag/v${VERSION}`}
      class="caption-4 w-fit border border-line-strong bg-black px-2.5 py-1 font-mono text-muted transition-colors duration-200 ease-base hover:text-fg"
    >
      v{VERSION} · open source · AGPL-3.0
    </a>
    <h1 id="hero-title" class="heading-3 sm:heading-2 lg:heading-1 mt-6 max-w-[15ch] text-fg">
      Code with any model, from your terminal
    </h1>
    <p class="body-3 sm:title-2 mt-6 max-w-[38rem] !font-normal text-fg">
      <span class="bg-black [box-decoration-break:clone]">nyq is a coding agent that reads your code, runs your tests and edits files.
      Bring the ChatGPT or Grok plan you pay for, an API key, or a local model.</span>
    </p>
    <div class="mt-10" id="install">
      <Install id="install-top" />
    </div>
  </div>
</section>
