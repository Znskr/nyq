---
import Install from "./Install.astro";
---
<section class="reveal px-6 py-24" aria-labelledby="cta-title">
  <div class="mx-auto flex min-w-0 max-w-4xl flex-col items-center gap-8 rounded-3xl border border-line bg-surface px-6 py-16 text-center sm:px-12">
    <h2 id="cta-title" class="heading-4 sm:heading-3 max-w-[680px]">
      Try it on your next bug
    </h2>
    <p class="body-3 max-w-xl text-muted">
      Free and open source. No account with us and no telemetry, and{" "}
      <code class="font-mono text-fg">nyq logout</code> removes every key it stored.
    </p>
    <Install id="install-bottom" align="center" tone="bg-bg" />
  </div>
</section>
