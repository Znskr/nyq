---
// Large type that lights up word by word as it scrolls into view.
const lines = ["Bring your own model.", "Keep your own terminal."];
---
<section class="band" aria-label="Tagline">
  <div class="rail px-5 py-28 sm:px-10">
    <p class="heading-3 sm:heading-2 lg:heading-1 mx-auto max-w-[680px] text-center text-fg" data-tagline>
      {lines.map((line, i) => (
        <>
          {line.split(" ").map((w) => <span class="tagline-word">{w} </span>)}
          {i < lines.length - 1 && <br />}
        </>
      ))}
    </p>
  </div>
</section>
