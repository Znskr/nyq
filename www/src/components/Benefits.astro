---
import Icon from "./Icon.astro";

const benefits = [
  {
    icon: "clock-counter-clockwise",
    title: "Undo what it changed",
    body: "<code>/undo</code> reverts nyq's file edits one at a time. Every session is saved, and <code>nyq -c</code> picks up where you left off.",
  },
  {
    icon: "hand-palm",
    title: "Approve what matters",
    body: "Reads run on their own; edits and commands can ask first. Hooks can block or rewrite any tool call before it runs.",
  },
  {
    icon: "plugs",
    title: "Fits the setup you have",
    body: "MCP servers, skills, hooks and subagents work out of the box. Zed can drive nyq over the Agent Client Protocol.",
  },
  {
    icon: "code-block",
    title: "Script it in CI",
    body: "<code>nyq -p</code> prints one answer and exits. <code>nyq ask --json</code> returns the answer, every tool call and an exit code.",
  },
  {
    icon: "cpu",
    title: "Local models too",
    body: "Point nyq at Ollama, llama.cpp or vLLM and keep your code on your machine. Same tools, same key bindings.",
  },
  {
    icon: "package",
    title: "One small binary",
    body: "Written in Rust and shipped as a single static binary. No runtime to install, and <code>nyq upgrade</code> keeps it current.",
  },
];
---
<section class="band" aria-labelledby="more-title">
  <div class="rail">
    <div class="reveal flex max-w-2xl flex-col gap-4 px-5 pb-12 pt-20 sm:px-10">
      <p class="caption-3 font-mono text-faint">02 / And more</p>
      <h2 id="more-title" class="heading-4 sm:heading-3">Everything else you expect from an agent</h2>
    </div>
    <ul class="grid gap-px border-t border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {benefits.map((b) => (
        <li class="group flex flex-col gap-3 bg-bg p-6 transition-colors duration-300 ease-base hover:bg-surface sm:p-8">
          <Icon name={b.icon} class="size-6 text-fg" />
          <h3 class="title-2 mt-3 text-fg">{b.title}</h3>
          <p class="body-6 text-muted [&_code]:whitespace-nowrap [&_code]:font-mono [&_code]:text-fg" set:html={b.body} />
        </li>
      ))}
    </ul>
  </div>
</section>
