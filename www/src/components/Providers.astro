---
const providers = [
  "ChatGPT subscription",
  "SuperGrok and X Premium",
  "Anthropic API",
  "xAI API",
  "OpenCode Zen",
  "OpenCode Go",
  "OpenRouter",
  "Ollama",
  "Any OpenAI compatible API",
];
---
<section class="band" aria-labelledby="providers-title">
  <div class="rail flex flex-col items-center gap-6 px-5 py-14 sm:px-10">
    <h2 id="providers-title" class="caption-3 font-mono text-faint">Works with the subscriptions and keys you already have</h2>
    <ul class="flex flex-wrap justify-center gap-2">
      {providers.map((p) => (
        <li class="body-5 border border-line px-3 py-1 font-mono text-[13px] text-muted">{p}</li>
      ))}
    </ul>
  </div>
</section>
