---
const steps = [
  {
    n: "1",
    title: "Install",
    body: "One command downloads a single binary for your platform and verifies its SHA256 checksum. No runtime to install.",
    code: "curl -fsSL nyq.zalthar.com/install.sh | sh",
  },
  {
    n: "2",
    title: "Sign in",
    body: "Use the browser login for ChatGPT or Grok, paste an API key, or point nyq at Ollama.",
    code: "nyq login",
  },
  {
    n: "3",
    title: "Ask",
    body: "Describe the change. nyq reads, edits and tests until it can show you the answer.",
    code: 'nyq "fix the failing test"',
  },
];
---
<section id="how" class="band" aria-labelledby="how-title">
  <div class="rail">
    <div class="reveal flex max-w-2xl flex-col gap-4 px-5 pb-12 pt-20 sm:px-10">
      <p class="caption-3 font-mono text-faint">03 / How it works</p>
      <h2 id="how-title" class="heading-4 sm:heading-3">From install to first fix in three commands</h2>
    </div>
    <ol class="grid gap-px border-t border-line bg-line md:grid-cols-3">
      {steps.map((s) => (
        <li class="flex min-w-0 flex-col gap-4 bg-bg p-6 sm:p-8">
          <span class="caption-3 font-mono text-faint">STEP {s.n}</span>
          <h3 class="title-1 text-fg">{s.title}</h3>
          <p class="body-6 flex-1 text-muted">{s.body}</p>
          <code class="block overflow-x-auto whitespace-nowrap border border-line bg-surface px-3 py-2 font-mono text-[13px] text-fg [scrollbar-width:none]">
            <span class="select-none text-faint">$ </span>{s.code}
          </code>
        </li>
      ))}
    </ol>
  </div>
</section>
