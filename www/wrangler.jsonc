// Cloudflare Workers static assets: no Worker script, so every request is a
// free static asset request. Deploy with `pnpm run deploy` or .github/workflows/www.yml.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nyq",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
